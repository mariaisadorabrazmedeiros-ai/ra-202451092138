<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Pets para Adoção - Encontre seu novo melhor amigo</title>

  <style>

    :root {
      --marrom: #713600;
      --marrom-escuro: #512600;
      --amarelo: #fdfbd4;
      --azul: #1f3864;
      --fundo: #f5f7fa;
      --branco: #ffffff;
      --borda: #e2e8f0;
      --espaco: 20px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: system-ui, "Segoe UI", Arial, sans-serif;
      color: #1e293b;
      background: var(--fundo);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: var(--azul);
    }

    header {
      background: var(--marrom);
      color: var(--branco);
      padding: 24px 32px 16px;
    }

    .site-nome {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .subtitulo-site {
      font-size: 14px;
      color: #f7f7f7;
      margin: 0;
    }

    nav {
      background: var(--amarelo);
      padding: 10px 32px;
    }

    nav a {
      color: #020202;
      text-decoration: none;
      margin-right: 20px;
      font-size: 14px;
    }

    nav a:hover,
    nav a:focus {
      text-decoration: underline;
    }

    main.conteudo {
      display: flex;
      gap: 24px;
      padding: 28px 32px;
      align-items: flex-start;
    }

    .miolo {
      flex: 1 1 auto;
      min-width: 0;
    }

    aside {
      flex: 0 0 250px;
      background: var(--branco);
      border: 1px solid var(--borda);
      border-radius: 6px;
      padding: 16px 20px;
    }

    .post {
      background: var(--branco);
      border: 1px solid var(--borda);
      border-radius: 6px;
      padding: 20px 24px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 24px;
      font-weight: 700;
      color: #c05800;
      margin: 0 0 12px;
    }

    h2 {
      font-size: 19px;
      font-weight: 700;
      color: var(--azul);
      margin: 22px 0 10px;
    }

    h3 {
      font-size: 17px;
      font-weight: 700;
      color: var(--azul);
      margin: 0 0 6px;
    }

    p {
      margin: 0 0 12px;
    }

    ul {
      margin: 0 0 12px;
      padding-left: 22px;
    }

    li {
      margin-bottom: 4px;
    }

    figure {
      margin: 18px 0 24px;
    }

    figure img {
      display: block;
      width: 100%;
      max-width: 720px;
      height: auto;
      border-radius: 8px;
    }

    figcaption {
      margin-top: 8px;
      font-size: 13px;
      color: #475569;
    }

    form {
      display: grid;
      gap: 20px;
    }

    fieldset {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 18px;
    }

    legend {
      font-weight: 700;
      color: var(--azul);
      padding: 0 8px;
    }

    label,
    .label-grupo {
      display: block;
      font-weight: 600;
      margin: 12px 0 6px;
    }

    input,
    select,
    textarea {
      width: 100%;
      max-width: 100%;
      padding: 10px 12px;
      border: 1px solid #94a3b8;
      border-radius: 4px;
      font: inherit;
      background: var(--branco);
    }

    textarea {
      resize: vertical;
    }

    input[type="radio"],
    input[type="checkbox"] {
      width: auto;
      margin-right: 6px;
    }

    .opcoes label {
      display: inline-block;
      margin-right: 18px;
      font-weight: 400;
    }

    button {
      width: fit-content;
      padding: 10px 18px;
      border: 0;
      border-radius: 5px;
      background: var(--marrom);
      color: var(--branco);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      background: var(--marrom-escuro);
    }

    a:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    button:focus-visible {
      outline: 3px solid #2e75b6;
      outline-offset: 3px;
    }

    .cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--espaco);
    }

    .card {
      background: var(--branco);
      border: 1px solid var(--borda);
      border-radius: 6px;
      overflow: hidden;
    }

    .card img {
      display: block;
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .card-conteudo {
      padding: 15px;
    }

    .card-conteudo span {
      display: inline-block;
      background: #eef3fa;
      color: var(--azul);
      border-radius: 4px;
      padding: 2px 8px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .filtros {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 20px;
      padding: 15px;
      background: #f8fafc;
      border: 1px solid var(--borda);
      border-radius: 6px;
    }

    .filtros label {
      margin: 0 0 6px;
    }

    .resultado-busca {
      font-weight: 600;
      color: var(--azul);
    }

    .dados-pet {
      font-size: 14px;
      margin: 10px 0;
    }

    .botao-adotar {
      display: inline-block;
      margin-top: 8px;
      padding: 8px 12px;
      background: var(--marrom);
      color: white;
      border-radius: 5px;
      text-decoration: none;
      font-weight: 700;
    }

    .botao-adotar:hover {
      background: var(--marrom-escuro);
    }

    .confirmacao {
      display: none;
      margin-top: 18px;
      padding: 14px;
      background: #e8f5e9;
      border: 1px solid #81c784;
      border-radius: 6px;
      color: #1b5e20;
      font-weight: 600;
    }

    footer {
      background: #38240D;
      color: var(--branco);
      padding: 18px 32px;
      font-size: 13px;
      text-align: center;
    }

    footer p {
      margin: 4px 0;
    }

    footer a {
      color: var(--branco);
    }

    .selo {
      display: inline-block;
      background: #eef3fa;
      color: var(--azul);
      border-radius: 4px;
      padding: 2px 8px;
      font-size: 12px;
      font-weight: 700;
    }

    main.conteudo {
      flex-direction: column;
      padding: 20px;
    }

    aside {
      width: 100%;
      flex-basis: auto;
    }

    header,
    nav,
    footer {
      padding-left: 20px;
      padding-right: 20px;
    }

    nav a {
      display: inline-block;
      margin-bottom: 6px;
    }

    @media (max-width: 700px) {
      .filtros {
        grid-template-columns: 1fr;
      }
    }

    @media (min-width: 768px) {

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      main.conteudo {
        flex-direction: row;
      }

      aside {
        width: auto;
      }

    }

    @media (min-width: 1024px) {

      .cards {
        grid-template-columns: repeat(4, 1fr);
      }

    }

  </style>
</head>

<body>

  <header id="inicio">

    <p class="site-nome">
      Pets para Adoção - Encontre seu novo melhor amigo
    </p>

    <p class="subtitulo-site">
      Cães e gatos resgatados esperando por uma família.
      Cada pet tem uma história e espera pela oportunidade
      de fazer parte de uma família.
    </p>

  </header>

  <nav aria-label="Navegação principal">

    <a href="#como-ajudar">Como Ajudar</a>
    <a href="#faq">FAQ</a>
    <a href="#sobre-o-site">Sobre o Site</a>
    <a href="#adocao">Adoção</a>
    <a href="#pets-titulo">Pets</a>

  </nav>

  <main class="conteudo">

    <div class="miolo">

      <section id="como-ajudar" class="post">

        <h1>Como Ajudar</h1>

        <figure>

          <img
            src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=900&q=80"
            alt="Cão e gato juntos representando a adoção responsável"
            width="900"
            height="600">

          <figcaption>
            Adotar é oferecer uma nova oportunidade
            com carinho e responsabilidade.
          </figcaption>

        </figure>

        <h2>Toda ajuda pode transformar uma vida</h2>

        <p>
          Existem diversas maneiras de contribuir para que cães
          e gatos encontrem um lar seguro e recebam os cuidados
          necessários. Mesmo que você não possa adotar neste
          momento, ainda pode fazer a diferença.
        </p>

        <h2>Adote com responsabilidade</h2>

        <p>
          Ao adotar, você oferece uma nova oportunidade para
          um animal que precisa de carinho, proteção e segurança.
        </p>

        <p>
          Antes de tomar essa decisão, avalie se possui tempo,
          espaço e condições para cuidar do pet durante toda
          a vida dele.
        </p>

        <h2>Ofereça um lar temporário</h2>

        <p>
          O lar temporário acolhe o animal por um período
          determinado, enquanto ele aguarda uma família definitiva.
          Essa ajuda proporciona mais segurança, conforto e atenção
          ao pet durante o processo de adoção.
        </p>

        <h2>Faça uma doação</h2>

        <p>As doações podem ajudar na compra de:</p>

        <ul>
          <li>Ração</li>
          <li>Medicamentos</li>
          <li>Vacinas</li>
          <li>Produtos de higiene</li>
          <li>Cobertores e caminhas</li>
          <li>Coleiras e guias</li>
          <li>Materiais para limpeza</li>
          <li>Consultas e procedimentos veterinários</li>
        </ul>

        <p>
          Antes de realizar uma doação, entre em contato com
          os responsáveis pelo projeto para conhecer as necessidades
          atuais e os canais oficiais.
        </p>

        <p>
          <strong>Contato:</strong>
          mariaisadorabrazmedeiros@gmail.com
        </p>

        <p>
          <strong>Endereço:</strong>
          XPTO, 999 - Bairro São Francisco - Belo Horizonte/MG
        </p>

        <p>
          <strong>Horário:</strong>
          Seg. a sex., 9h às 17h
        </p>

        <h2>Seja voluntário</h2>

        <p>
          Você também pode colaborar oferecendo seu tempo
          e suas habilidades. Os voluntários podem ajudar em
          atividades como:
        </p>

        <ul>
          <li>Divulgação dos animais</li>
          <li>Produção de fotos e vídeos</li>
          <li>Transporte dos pets</li>
          <li>Organização de campanhas</li>
          <li>Participação em eventos de adoção</li>
          <li>Arrecadação de alimentos e materiais</li>
          <li>Apoio nos cuidados diários</li>
        </ul>

        <h2>Compartilhe</h2>

        <p>
          Divulgar os perfis dos animais disponíveis aumenta
          as chances de adoção. Compartilhe o site e as publicações
          do projeto com amigos, familiares e em suas redes sociais.
        </p>

        <p>
          Um simples compartilhamento pode ajudar um pet
          a encontrar uma família.
        </p>

      </section>

      <section id="faq" class="post">

        <h1>FAQ</h1>

        <h2>Perguntas frequentes</h2>

        <p>
          Encontre respostas para as principais dúvidas sobre
          adoção, cuidados e funcionamento do site.
        </p>

        <h2>Como posso adotar um animal?</h2>

        <p>
          Acesse a página de animais disponíveis, escolha o pet
          que deseja conhecer e entre em contato por meio do canal
          informado em seu perfil.
        </p>

        <h2>Quais são os requisitos para adotar?</h2>

        <p>
          Os requisitos podem variar. Geralmente, o interessado
          deve ser maior de idade, apresentar identificação e
          demonstrar condições para oferecer alimentação,
          cuidados veterinários, segurança e atenção.
        </p>

        <h2>A adoção é gratuita?</h2>

        <p>
          Normalmente, a adoção não envolve a compra do animal.
          Porém, o adotante deve estar preparado para os custos
          de alimentação, vacinação, higiene e cuidados veterinários.
        </p>

        <h2>Posso conhecer o pet antes de adotar?</h2>

        <p>
          Sim. Sempre que possível, é importante conhecer o animal
          antes de concluir a adoção para entender seu comportamento
          e suas necessidades.
        </p>

        <h2>Os animais são vacinados e castrados?</h2>

        <p>
          Essa informação varia de acordo com cada pet.
          Consulte o perfil do animal ou entre em contato
          com os responsáveis.
        </p>

        <h2>Posso adotar se já tenho outros animais?</h2>

        <p>
          Sim, desde que seja possível realizar uma adaptação
          segura e gradual. Informe aos responsáveis que você
          já possui outros animais.
        </p>

        <h2>Posso adotar um animal para outra pessoa?</h2>

        <p>
          A adoção deve ser realizada pela pessoa que será
          responsável pelo pet. Animais não devem ser oferecidos
          como presentes ou surpresas.
        </p>

        <h2>O que acontece se eu não puder mais cuidar do animal?</h2>

        <p>
          Entre em contato com os responsáveis pela adoção antes
          de entregar o animal a outra pessoa ou abandoná-lo.
        </p>

        <h2>Como posso ajudar sem adotar?</h2>

        <p>
          Você pode divulgar os animais, oferecer lar temporário,
          doar materiais, participar de campanhas ou atuar como voluntário.
        </p>

        <h2>Encontrei um animal abandonado. O que devo fazer?</h2>

        <p>
          Se for seguro, ofereça água e mantenha o animal protegido
          do trânsito e de outros perigos. Procure atendimento veterinário
          ou organizações de proteção animal.
        </p>

        <h2>As informações dos animais são atualizadas?</h2>

        <p>
          O site busca manter os perfis atualizados, mas um animal
          pode ser adotado antes da atualização. Entre em contato
          para confirmar a disponibilidade.
        </p>

      </section>

      <section id="sobre-o-site" class="post">

        <h1>Sobre o Site</h1>

        <h2>Sobre o projeto</h2>

        <p>
          Este site foi criado para dar visibilidade a cães e gatos
          que estão à procura de uma família. Nosso objetivo é facilitar
          o encontro entre animais disponíveis para adoção e pessoas
          preparadas para oferecer um lar seguro, responsável e cheio de carinho.
        </p>

        <p>
          Cada perfil apresenta informações importantes sobre o pet,
          como idade aproximada, porte, personalidade, condições de
          saúde e necessidades especiais.
        </p>

        <h2>Nossa missão</h2>

        <p>
          Promover a adoção responsável e contribuir para que mais
          animais tenham acesso a cuidado, proteção e qualidade de vida.
        </p>

        <h2>Nossa visão</h2>

        <p>
          Ser um espaço confiável e acessível para a divulgação
          de animais disponíveis para adoção.
        </p>

        <h2>Nossos valores</h2>

        <ul>
          <li><strong>Respeito:</strong> todos os animais merecem cuidado e proteção.</li>
          <li><strong>Responsabilidade:</strong> adotar é assumir um compromisso para toda a vida.</li>
          <li><strong>Transparência:</strong> as informações devem ser apresentadas de maneira clara.</li>
          <li><strong>Empatia:</strong> cada animal possui uma história e necessidades específicas.</li>
          <li><strong>Colaboração:</strong> famílias, voluntários e organizações podem transformar vidas juntos.</li>
        </ul>

        <h2>Como o site funciona?</h2>

        <ul>
          <li>Os animais disponíveis são cadastrados com fotos e informações.</li>
          <li>O visitante acessa os perfis e conhece as características de cada pet.</li>
          <li>O visitante entra em contato com os responsáveis.</li>
          <li>Os responsáveis avaliam as condições para uma adoção segura.</li>
          <li>Após a aprovação, o animal é encaminhado para sua nova família.</li>
        </ul>

        <h2>Adoção responsável</h2>

        <p>
          A adoção deve ser uma decisão consciente. Antes de adotar,
          é importante considerar os custos, o espaço disponível,
          o tempo necessário e as possíveis mudanças na rotina da família.
        </p>

        <h2>Importante</h2>

        <p>
          O site atua como um canal de divulgação e aproximação.
          A responsabilidade pelas informações, entrevistas, visitas,
          documentos e entrega dos animais pertence aos responsáveis
          indicados em cada perfil.
        </p>

        <p>
          Não envie documentos, valores ou informações pessoais sem
          verificar a identidade e a legitimidade dos envolvidos.
        </p>

        <h2>Juntos podemos transformar vidas</h2>

        <p>
          Cada adoção representa uma nova oportunidade.
          Ao conhecer, divulgar ou adotar um pet, você contribui
          para um futuro mais seguro e acolhedor.
        </p>

      </section>

      <section id="adocao" class="post">

        <h1>Quero ajudar na adoção</h1>

        <p>
          Preencha o formulário abaixo para demonstrar interesse
          em adotar, oferecer lar temporário ou atuar como voluntário.
        </p>

        <form action="#" method="post">

          <fieldset>

            <legend>Dados para contato</legend>

            <label for="nome">Nome completo</label>

            <input
              type="text"
              id="nome"
              name="nome"
              required
              minlength="3"
              maxlength="80"
              pattern="[A-Za-zÀ-ÿ ]{3,80}"
              autocomplete="name">

            <label for="email">E-mail</label>

            <input
              type="email"
              id="email"
              name="email"
              required
              minlength="5"
              maxlength="120"
              autocomplete="email">

            <label for="telefone">Telefone</label>

            <input
              type="tel"
              id="telefone"
              name="telefone"
              required
              minlength="10"
              maxlength="15"
              pattern="[0-9() +\-]{10,15}"
              autocomplete="tel">

            <label for="idade">Idade</label>

            <input
              type="number"
              id="idade"
              name="idade"
              required
              min="18"
              max="100">

            <label for="data">Data de disponibilidade</label>

            <input
              type="date"
              id="data"
              name="data"
              required>

            <label for="cidade">Cidade</label>

            <input
              type="text"
              id="cidade"
              name="cidade"
              required
              minlength="2"
              maxlength="60">

          </fieldset>

          <fieldset>

            <legend>Interesse</legend>

            <label for="tipo-ajuda">Como deseja ajudar?</label>

            <select
              id="tipo-ajuda"
              name="tipo-ajuda"
              required>

              <option value="">Selecione uma opção</option>
              <option value="adocao">Adotar um pet</option>
              <option value="lar-temporario">Oferecer lar temporário</option>
              <option value="voluntario">Ser voluntário</option>
              <option value="doacao">Fazer uma doação</option>

            </select>

            <label for="pet-desejado">
              Nome do pet desejado
            </label>

            <select
              id="pet-desejado"
              name="pet-desejado"
              required>

              <option value="">Selecione um pet</option>
              <option value="Mel">Mel</option>
              <option value="Theo">Theo</option>
              <option value="Luna">Luna</option>
              <option value="Max">Max</option>
              <option value="Nina">Nina</option>
              <option value="Thor">Thor</option>
              <option value="Amora">Amora</option>
              <option value="Bob">Bob</option>

            </select>

            <p class="label-grupo">
              Qual tipo de animal você prefere?
            </p>

            <div class="opcoes">

              <label>
                <input
                  type="radio"
                  name="animal"
                  value="cao"
                  required>
                Cão
              </label>

              <label>
                <input
                  type="radio"
                  name="animal"
                  value="gato">
                Gato
              </label>

              <label>
                <input
                  type="radio"
                  name="animal"
                  value="qualquer">
                Qualquer um
              </label>

            </div>

            <label>

              <input
                type="checkbox"
                name="contato-email"
                value="sim">

              Aceito receber contato pelo e-mail.

            </label>

            <label for="mensagem">
              Motivo da adoção
            </label>

            <textarea
              id="mensagem"
              name="mensagem"
              rows="5"
              required
              minlength="20"
              maxlength="500"
              placeholder="Conte por que deseja adotar este pet."></textarea>

          </fieldset>

          <button type="submit">
            Enviar interesse
          </button>

          <div id="confirmacao" class="confirmacao" aria-live="polite">
            Interesse enviado com sucesso! Em breve entraremos em contato.
          </div>

        </form>

      </section>

      <section class="post" aria-labelledby="pets-titulo">

        <h2 id="pets-titulo">
          Pets disponíveis para adoção
        </h2>

        <div class="filtros">

          <div>
            <label for="busca">Buscar por nome</label>
            <input
              type="search"
              id="busca"
              placeholder="Digite o nome do pet">
          </div>

          <div>
            <label for="filtro-especie">Espécie</label>

            <select id="filtro-especie">
              <option value="">Todas</option>
              <option value="Cão">Cão</option>
              <option value="Gato">Gato</option>
            </select>
          </div>

          <div>
            <label for="filtro-porte">Porte</label>

            <select id="filtro-porte">
              <option value="">Todos</option>
              <option value="Pequeno">Pequeno</option>
              <option value="Médio">Médio</option>
              <option value="Grande">Grande</option>
            </select>
          </div>

          <div>
            <label for="filtro-idade">Faixa etária</label>

            <select id="filtro-idade">
              <option value="">Todas</option>
              <option value="Filhote">Filhote</option>
              <option value="Jovem">Jovem</option>
              <option value="Adulto">Adulto</option>
              <option value="Idoso">Idoso</option>
            </select>
          </div>

        </div>

