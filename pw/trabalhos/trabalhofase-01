  <script>

    const busca = document.getElementById("busca");
    const especie = document.getElementById("filtro-especie");
    const porte = document.getElementById("filtro-porte");
    const idade = document.getElementById("filtro-idade");

    const cards = document.querySelectorAll(".card");

    const resultado = document.getElementById("resultado-busca");

    const pet = document.getElementById("pet-desejado");

    const form = document.querySelector("#adocao form");

    const confirmacao = document.getElementById("confirmacao");


    function filtrarPets() {

      let quantidade = 0;

      const nome = busca.value.toLowerCase().trim();

      cards.forEach(function(card) {

        const nomePet = card.dataset.nome.toLowerCase();

        const especiePet = card.dataset.especie;
        const portePet = card.dataset.porte;
        const idadePet = card.dataset.idade;

        const encontrouNome = nomePet.includes(nome);

        const encontrouEspecie =
          !especie.value ||
          especiePet === especie.value;

        const encontrouPorte =
          !porte.value ||
          portePet === porte.value;

        const encontrouIdade =
          !idade.value ||
          idadePet === idade.value;

        const mostrar =
          encontrouNome &&
          encontrouEspecie &&
          encontrouPorte &&
          encontrouIdade;

        card.style.display = mostrar ? "" : "none";

        if (mostrar) {
          quantidade++;
        }

      });

      resultado.textContent =
        quantidade +
        (quantidade === 1
          ? " pet encontrado."
          : " pets encontrados.");

    }


    busca.addEventListener("input", filtrarPets);

    especie.addEventListener("change", filtrarPets);

    porte.addEventListener("change", filtrarPets);

    idade.addEventListener("change", filtrarPets);


    document.querySelectorAll(".botao-adotar").forEach(function(botao) {

      botao.addEventListener("click", function() {

        pet.value = botao.dataset.pet;

      });

    });


    form.addEventListener("submit", function(evento) {

      evento.preventDefault();

      if (!form.checkValidity()) {

        form.reportValidity();

        return;

      }

      confirmacao.style.display = "block";

      confirmacao.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });

      form.reset();

    });

  </script>

