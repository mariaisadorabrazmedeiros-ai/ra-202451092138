    }
    .titulo-g, h1 { font-size: 24px; font-weight: 700; color: #1f3864; margin: 0 0 12px; }
    .titulo-m, h2 { font-size: 19px; font-weight: 700; color: #1f3864; margin: 0 0 10px; }
    .titulo-p, h3 { font-size: 15px; font-weight: 700; color: #2e75b6; margin: 0 0 6px; }
    .texto, p { margin: 0 0 12px; }
    .lista, ul { margin: 0 0 12px; padding-left: 22px; }
    .rodape, footer {
      background: #1f3864; color: #aec3e0; padding: 18px 32px;
      font-size: 13px; text-align: center;
    }
    .selo { display: inline-block; background: #eef3fa; color: #1f3864;
