  <!--
    PAGINA A — "div soup"
    Toda a estrutura foi feita com <div class="...">. Nenhum elemento diz o que ele E.
    O CSS abaixo e IDENTICO ao da pagina-b.html: ele estiliza tanto as classes (pagina A)
    quanto os elementos semanticos (pagina B). Por isso as duas paginas renderizam igual.
    NAO altere o CSS de um arquivo sem alterar o do outro.
  -->
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, Segoe UI, Arial, sans-serif;
      color: #1e293b;
      background: #f5f7fa;
      line-height: 1.6;
    }
    .topo, header { background: #1f3864; color: #fff; padding: 24px 32px 16px; }
    .titulo-site, .site-nome { font-size: 26px; font-weight: 700; margin: 0 0 4px; }
    .subtitulo-site { font-size: 14px; color: #aec3e0; margin: 0; }
    .menu, nav { background: #2e75b6; padding: 10px 32px; }
    .menu a, nav a { color: #fff; text-decoration: none; margin-right: 20px; font-size: 14px; }
    .menu a:hover, nav a:hover { text-decoration: underline; }
    .conteudo { display: flex; gap: 24px; padding: 28px 32px; align-items: flex-start; }
    .miolo, main { flex: 1 1 auto; }
    .lateral, aside {
      flex: 0 0 250px; background: #fff; border: 1px solid #e2e8f0;
      border-radius: 6px; padding: 16px 20px;
    }
